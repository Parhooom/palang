func fibo(int n) {
    int a;
    a = 1;

    int b;
    b = 1;

    int tmp;
    tmp = 0;

    int count;
    count = 1;

    while (count <= n) {
        print(a);

        tmp = a + b;
        a = b;
        b = tmp;

        count = count + 1;
    }
}

func main() int {
    fibo(20);

    return 0;
}
